<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="48dp"
    android:background="#0b0b0f">

    <TextView
        android:id="@+id/estado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:textSize="22sp"
        android:text="@string/procurando" />

    <!-- Os servidores achados entram aqui como botoes, um por linha, ja
         focaveis pelo controle. -->
    <LinearLayout
        android:id="@+id/achados"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <EditText
        android:id="@+id/manual"
        android:layout_width="420dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:hint="@string/endereco_manual"
        android:inputType="text"
        android:textColor="#f2f2f2"
        android:textColorHint="#8a8a8a" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp">

        <Button
            android:id="@+id/conectar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/conectar" />

        <Button
            android:id="@+id/procurar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/procurar_de_novo" />
    </LinearLayout>
</LinearLayout>
