# ──────────────────────────────────────────
#  TicianoFlix — .gitignore
#  Segurança: nada de secrets, cache, ou
#  artifacts locais no repositório.
# ──────────────────────────────────────────

# 🐍 Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
*.egg
*.whl
*.so
*.pkl

# ⚙️ Wrapper nativo macOS (compilado via build-macos.sh)
ticianoflix-server
zaparoo-watchdog

# ⚙️ Virtualenv
env/
venv/
.venv/
*.env
*.env.local

# 📦 AppImage (gerado localmente)
*.AppImage
*.AppImage.home

# 💾 Cache do TicianoFlix
.cache/
cache/
downloads/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# 🔑 Secrets / Credenciais
*.pem
*.key
*.cert
*.crt
id_rsa
id_ed25519
**/rclone.conf
**/rclone*.conf
credentials.json
client_secret*.json
token*.json
*.cred
*.credential
oauth_token*
*_rsa
*_ed25519

# 📋 Config local
*.local/
*.local.*
config.local.*
.envrc
.direnv/

# 🔧 IDE / Editor
.vscode/
.idea/
.zcode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.sublime-*
*.bak
*.orig

# 📸 Wallpapers (output script)
wallpaper_cachyos.py
*.png
!assets/*.png
!favicon.png

# 📝 Logs
*.log
*.log.*

# 📦 Pacotes / Tarballs
*.tar.gz
*.tar.xz
*.tar.bz2
*.zip
*.7z

# 🧪 Test / Reports
scripts/
htmlcov/
.coverage
coverage/
pytest_cache/
.mypy_cache/
.ruff_cache/

# 🫥 OS
Desktop.ini
ehthumbs.db

# App de Android TV
tv/.gradle/
tv/build/
tv/app/build/
tv/local.properties
tv/.idea/
